# AttentionTwin Environment Configuration Template
# Copy this file to backend/.env or root .env as needed

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (Phase 2+)
DATABASE_URL=sqlite:///./attention_twin.db

